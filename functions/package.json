{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "logs": "firebase functions:log",
    "test": "jest --runInBand --verbose",
    "test:rules": "firebase emulators:exec --project demo-ai-planner --only firestore \"jest __tests__/firestore.rules.test.js --verbose --coverage=false --testPathIgnorePatterns=/node_modules/ --forceExit\"",
    "lint": "eslint .",
    "migrate:security:dry-run": "node scripts/security_migration.js --dry-run",
    "migrate:security:apply": "node scripts/security_migration.js --apply --confirm=SECURITY-MIGRATION-2026-06-21",
    "grant:credits": "node scripts/grant_credits.js",
    "migrate:key-binding": "node scripts/migrate_key_binding.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/kms": "^5.4.0",
    "@notionhq/client": "^5.6.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "googleapis": "^169.0.0",
    "heic-convert": "2.1.0",
    "node-fetch": "^2.7.0",
    "notion-multipart-uploader": "2.1.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^30.2.0"
  },
  "private": true,
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^firebase-functions/logger$": "<rootDir>/__mocks__/firebase-functions-logger.js",
      ".*/firebase-functions/lib/logger/index\\.js$": "<rootDir>/__mocks__/firebase-functions-logger.js",
      ".*/firebase-functions/lib/esm/logger/index\\.mjs$": "<rootDir>/__mocks__/firebase-functions-logger.js"
    },
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "firestore.rules.test.js",
      "/__tests__/helpers/",
      "/__tests__/fixtures/"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/"
    ]
  }
}
