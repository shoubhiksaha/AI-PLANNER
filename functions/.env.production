# Non-secret parameters for the PRODUCTION environment of project ai-planner-project-467800.
# Loaded by `firebase deploy --project production` (alias in .firebaserc).
# Secrets live in Google Cloud Secret Manager (shared by both environments).

APP_ENVIRONMENT=production
FIRESTORE_DATABASE_ID=(default)
FUNCTIONS_REGION=us-central1
APP_HOSTING_URL=https://planner.analogdigital.tech

KMS_KEY_NAME=projects/ai-planner-project-467800/locations/global/keyRings/byok-ring/cryptoKeys/byok-key
CASHFREE_ENVIRONMENT=production
CASHFREE_NOTIFY_URL=https://planner.analogdigital.tech/cashfreeWebhook
PAYMENTS_ENABLED=true
ALLOW_CUSTOM_BYOK_URLS=false
REQUIRE_APP_CHECK=false
