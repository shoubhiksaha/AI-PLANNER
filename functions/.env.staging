# Non-secret parameters for the STAGING environment of project ai-planner-project-467800.
# Loaded by `firebase deploy --project staging` (alias in .firebaserc, same project as production).
# Staging has its own Firestore database ("staging"), region and Hosting site; secrets are shared.

APP_ENVIRONMENT=staging
FIRESTORE_DATABASE_ID=staging
FUNCTIONS_REGION=asia-south1
APP_HOSTING_URL=https://ai-planner-staging.web.app

KMS_KEY_NAME=projects/ai-planner-project-467800/locations/global/keyRings/byok-ring/cryptoKeys/byok-key
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_NOTIFY_URL=https://ai-planner-staging.web.app/cashfreeWebhook
PAYMENTS_ENABLED=false
ALLOW_CUSTOM_BYOK_URLS=false
REQUIRE_APP_CHECK=false
