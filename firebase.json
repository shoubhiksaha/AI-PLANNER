{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "__tests__/**",
        "__mocks__/**",
        "coverage/**",
        "scripts/**",
        "*.test.js"
      ],
      "predeploy": [
        "bash \"$PROJECT_DIR/scripts/guard-deploy.sh\""
      ]
    }
  ],
  "hosting": {
    "site": "ai-planner-project-467800",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "__tests__/**",
      "coverage/**",
      "jest.config.js"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com https://accounts.google.com https://sdk.cashfree.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.cashfree.com; connect-src 'self' https://apis.google.com https://identitytoolkit.googleapis.com https://content-firebaseappcheck.googleapis.com https://www.google.com/recaptcha/ https://securetoken.googleapis.com https://firestore.googleapis.com https://www.googleapis.com https://us-central1-ai-planner-project-467800.cloudfunctions.net https://asia-south1-ai-planner-project-467800.cloudfunctions.net https://sdk.cashfree.com https://api.cashfree.com https://sandbox.cashfree.com; manifest-src 'self'; frame-src 'self' https://ai-planner-project-467800.firebaseapp.com https://ai-planner-project-467800.web.app https://ai-planner-staging.firebaseapp.com https://ai-planner-staging.web.app https://accounts.google.com https://planner.analogdigital.tech https://staging-planner.analogdigital.tech https://*.cashfree.com https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/sw*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/logClientError",
        "function": {
          "functionId": "logClientError",
          "region": "us-central1"
        }
      },
      {
        "source": "/syncPlanner",
        "function": {
          "functionId": "syncPlanner",
          "region": "us-central1"
        }
      },
      {
        "source": "/setupNotion",
        "function": {
          "functionId": "setupNotion",
          "region": "us-central1"
        }
      },
      {
        "source": "/updateProfile",
        "function": {
          "functionId": "updateProfile",
          "region": "us-central1"
        }
      },
      {
        "source": "/refreshStaleStreak",
        "function": {
          "functionId": "refreshStaleStreak",
          "region": "us-central1"
        }
      },
      {
        "source": "/exportUserData",
        "function": {
          "functionId": "exportUserData",
          "region": "us-central1"
        }
      },
      {
        "source": "/deleteUserAccount",
        "function": {
          "functionId": "deleteUserAccount",
          "region": "us-central1"
        }
      },
      {
        "source": "/setupBYOK",
        "function": {
          "functionId": "setupBYOK",
          "region": "us-central1"
        }
      },
      {
        "source": "/byokSession",
        "function": {
          "functionId": "byokSession",
          "region": "us-central1"
        }
      },
      {
        "source": "/createCashfreeOrder",
        "function": {
          "functionId": "createCashfreeOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/cashfreeWebhook",
        "function": {
          "functionId": "cashfreeWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/adminGrantCredits",
        "function": {
          "functionId": "adminGrantCredits",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "bash \"$PROJECT_DIR/scripts/guard-deploy.sh\""
    ]
  },
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json",
      "predeploy": [
        "bash \"$PROJECT_DIR/scripts/guard-deploy.sh\""
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
